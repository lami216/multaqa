# Docker Compose only: generate two DIFFERENT random hexadecimal passwords.
# Do not reuse credentials from any other application.
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
# Frontend: same-origin /api is the default; no private credentials belong here.
VITE_API_BASE_URL=
VITE_IMAGEKIT_PUBLIC_KEY=
VITE_IMAGEKIT_URL_ENDPOINT=
